{
  "name": "pt-monitor",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts && pnpm --filter pt-monitor-ui test",
    "serve": "tsx src/cli.ts serve",
    "ui:dev": "pnpm --filter pt-monitor-ui dev",
    "ui:build": "pnpm --filter pt-monitor-ui build",
    "ui:typecheck": "pnpm --filter pt-monitor-ui typecheck"
  },
  "dependencies": {
    "jsdom": "^27.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
