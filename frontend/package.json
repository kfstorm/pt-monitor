    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0"
